#!/bin/zsh
set -euo pipefail

cmd="${1:-}"
LOG_FILE=".adl/adl.log"

now_ts() { /bin/date "+%Y-%m-%dT%H:%M:%S%z"; }

log_event() {
  [[ "${ADL_LOG:-1}" != "0" ]] || return 0
  /bin/mkdir -p .adl 2>/dev/null || return 0
  print -r -- "ts=$(now_ts) version=adapter cwd=$PWD event=ghostty.$*" >> "$LOG_FILE" 2>/dev/null || return 0
}

die_transport() {
  print -r -- "$*" >&2
  exit 3
}

capture_dry_run() {
  local role="$1"
  local role_upper="${role:u}"
  if [[ -n "${ADL_GHOSTTY_DRY_RUN_TERMINAL_ID:-}" ]]; then
    print -r -- "ADL_${role_upper}_ADAPTER='ghostty-macos'"
    print -r -- "ADL_${role_upper}_TERMINAL_ID='$ADL_GHOSTTY_DRY_RUN_TERMINAL_ID'"
    print -r -- "ADL_${role_upper}_LABEL='Ghostty dry-run ${role} terminal'"
    return
  fi
  print -r -- "ADL_${role_upper}_ADAPTER='ghostty-macos'"
  print -r -- "ADL_${role_upper}_TERMINAL_ID='dry-run-${role}-terminal'"
  print -r -- "ADL_${role_upper}_LABEL='Ghostty dry-run ${role} terminal'"
}

case "$cmd" in
  capture-focused)
    role="${2:-}"
    [[ "$role" == "architect" || "$role" == "dev" ]] || die_transport "Usage: ghostty-macos capture-focused architect|dev"
    if [[ "${ADL_GHOSTTY_DRY_RUN:-0}" == "1" ]]; then
      capture_dry_run "$role"
      exit 0
    fi
    term_id="$(/usr/bin/osascript <<'APPLESCRIPT'
tell application "Ghostty"
  set frontWindow to «property GFWn»
  set selectedTab to «property GWsT» of frontWindow
  set focusedTerminal to «property GTfT» of selectedTab
  return («property ID  » of focusedTerminal as text)
end tell
APPLESCRIPT
)" || die_transport "Ghostty capture failed. Grant automation permission for osascript to control Ghostty, then refresh."
    [[ -n "$term_id" ]] || die_transport "Ghostty capture returned an empty terminal id"
    role_upper="${role:u}"
    print -r -- "ADL_${role_upper}_ADAPTER='ghostty-macos'"
    print -r -- "ADL_${role_upper}_TERMINAL_ID='$term_id'"
    print -r -- "ADL_${role_upper}_LABEL='Ghostty terminal $term_id'"
    ;;
  send)
    terminal_id="${2:-}"
    message="${3:-}"
    [[ -n "$terminal_id" ]] || die_transport "Missing terminal id"
    [[ -n "$message" ]] || die_transport "Missing message"
    if [[ "${ADL_GHOSTTY_DRY_RUN:-0}" == "1" ]]; then
      print -r -- "DRY RUN send to $terminal_id"
      exit 0
    fi
    log_event "send.start terminal=$terminal_id message_chars=${#message}"
    set +e
    send_output="$(/usr/bin/osascript - "$terminal_id" "$message" <<'APPLESCRIPT' 2>&1
on run argv
  set targetId to item 1 of argv
  set messageText to item 2 of argv
tell application "Ghostty"
  set targetTerm to missing value
  repeat with candidate in every «class Gtrm»
    if ((«property ID  » of candidate as text) is targetId) then
      set targetTerm to candidate
      exit repeat
    end if
  end repeat
  if targetTerm is missing value then error "target terminal not found for id " & targetId
  try
    «event GhstInTx» messageText given «class GItT»:targetTerm
  on error inputErr number inputErrNo
    error "input text failed after terminal lookup: " & inputErr & " (" & inputErrNo & ")"
  end try
  try
    «event GhstSKey» "enter" given «class GKeT»:targetTerm
  on error keyErr number keyErrNo
    error "send enter failed after text input: " & keyErr & " (" & keyErrNo & ")"
  end try
  return "send ok"
end tell
end run
APPLESCRIPT
)"
    send_code="$?"
    set -e
    if [[ "$send_code" != "0" ]]; then
      log_event "send.failed terminal=$terminal_id code=$send_code output=${(qqq)send_output}"
      [[ -n "$send_output" ]] && print -r -- "$send_output" >&2
      die_transport "Ghostty send failed. Reconnect the target terminal and retry."
    fi
    log_event "send.ok terminal=$terminal_id"
    ;;
  *)
    die_transport "Usage: ghostty-macos capture-focused architect|dev | send <terminal-id> <message>"
    ;;
esac
