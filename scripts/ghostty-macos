#!/bin/zsh
set -euo pipefail

cmd="${1:-}"

die_transport() {
  print -r -- "$*" >&2
  exit 3
}

escape_applescript_text() {
  local text="$1"
  text="${text//\\/\\\\}"
  text="${text//\"/\\\"}"
  print -r -- "$text"
}

capture_dry_run() {
  local role="$1"
  local role_upper="${role:u}"
  local prefix="ADL"
  if [[ "$role" == "commissioner" || "$role" == "consumer" ]]; then
    prefix="COMMISSION"
  fi
  if [[ -n "${ADL_GHOSTTY_DRY_RUN_TERMINAL_ID:-}" ]]; then
    print -r -- "${prefix}_${role_upper}_ADAPTER='ghostty-macos'"
    print -r -- "${prefix}_${role_upper}_TERMINAL_ID='$ADL_GHOSTTY_DRY_RUN_TERMINAL_ID'"
    print -r -- "${prefix}_${role_upper}_LABEL='Ghostty dry-run ${role} terminal'"
    return
  fi
  print -r -- "${prefix}_${role_upper}_ADAPTER='ghostty-macos'"
  print -r -- "${prefix}_${role_upper}_TERMINAL_ID='dry-run-${role}-terminal'"
  print -r -- "${prefix}_${role_upper}_LABEL='Ghostty dry-run ${role} terminal'"
}

case "$cmd" in
  capture-focused)
    role="${2:-}"
    [[ "$role" == "architect" || "$role" == "dev" || "$role" == "commissioner" || "$role" == "consumer" ]] || die_transport "Usage: ghostty-macos capture-focused architect|dev|commissioner|consumer"
    if [[ "${ADL_GHOSTTY_DRY_RUN:-0}" == "1" ]]; then
      capture_dry_run "$role"
      exit 0
    fi
    term_id="$(/usr/bin/osascript <<'APPLESCRIPT'
tell application "Ghostty"
  set frontWindow to «property GFWn»
  set selectedTab to «property GWsT» of frontWindow
  set focusedTerminal to «property GTfT» of selectedTab
  return («property ID  » of focusedTerminal as text)
end tell
APPLESCRIPT
)" || die_transport "Ghostty capture failed. Grant automation permission for osascript to control Ghostty, then refresh."
    [[ -n "$term_id" ]] || die_transport "Ghostty capture returned an empty terminal id"
    role_upper="${role:u}"
    prefix="ADL"
    if [[ "$role" == "commissioner" || "$role" == "consumer" ]]; then
      prefix="COMMISSION"
    fi
    print -r -- "${prefix}_${role_upper}_ADAPTER='ghostty-macos'"
    print -r -- "${prefix}_${role_upper}_TERMINAL_ID='$term_id'"
    print -r -- "${prefix}_${role_upper}_LABEL='Ghostty terminal $term_id'"
    ;;
  send)
    terminal_id="${2:-}"
    message="${3:-}"
    [[ -n "$terminal_id" ]] || die_transport "Missing terminal id"
    [[ -n "$message" ]] || die_transport "Missing message"
    if [[ "${ADL_GHOSTTY_DRY_RUN:-0}" == "1" ]]; then
      print -r -- "DRY RUN send to $terminal_id"
      exit 0
    fi
    escaped="$(escape_applescript_text "$message")"
/usr/bin/osascript <<APPLESCRIPT || die_transport "Ghostty send failed. Reconnect the target terminal and retry."
tell application "Ghostty"
  set targetId to "$terminal_id"
  set targetTerm to missing value
  repeat with candidate in every «class Gtrm»
    if ((«property ID  » of candidate as text) is targetId) then
      set targetTerm to candidate
      exit repeat
    end if
  end repeat
  if targetTerm is missing value then error "target terminal not found"
  «event GhstInTx» "$escaped" given «class GItT»:targetTerm
  «event GhstSKey» "enter" given «class GKeT»:targetTerm
end tell
APPLESCRIPT
    ;;
  *)
    die_transport "Usage: ghostty-macos capture-focused architect|dev|commissioner|consumer | send <terminal-id> <message>"
    ;;
esac
