#!/bin/zsh
set -euo pipefail
setopt EXTENDED_GLOB

SCRIPT_PATH="${0:A}"
SCRIPT_DIR="${SCRIPT_PATH:h}"
ADAPTER_DIR="${COMMISSION_SCRIPT_ROOT:-$SCRIPT_DIR}"
GHOSTTY="$ADAPTER_DIR/ghostty-macos"
SKILLS_DIR="${COMMISSION_CODEX_SKILLS_DIR:-$HOME/.codex/skills}"
GLOBAL_MARKER="$SKILLS_DIR/commission/.commission-framework"
COMMISSION_DIR=".commission"
SESSIONS_DIR="$COMMISSION_DIR/sessions"
STAGING_DIR="$COMMISSION_DIR/staging"
ACTIVE_FILE="$COMMISSION_DIR/active-session"
DATE="/bin/date"
CAT="/bin/cat"
VERSION_FILE="$SCRIPT_DIR/../VERSION"
VERSION="$("$CAT" "$VERSION_FILE" 2>/dev/null || print -r -- "0.0.0-consumer")"
CP="/bin/cp"
MKDIR="/bin/mkdir"
MV="/bin/mv"
RM="/bin/rm"
AWK="/usr/bin/awk"
LOG_FILE="$COMMISSION_DIR/commission.log"
ROUTING_DIR="${COMMISSION_ROUTING_DIR:-$HOME/.commission}"
PIN_INDEX_DIR="$ROUTING_DIR/pins"
CONSUMER_INDEX_DIR="$ROUTING_DIR/consumers"
CKSUM="/usr/bin/cksum"
GIT="/usr/bin/git"

log_enabled() { [[ "${COMMISSION_LOG:-1}" != "0" ]]; }

log_event() {
  log_enabled || return 0
  "$MKDIR" -p "$COMMISSION_DIR" 2>/dev/null || return 0
  print -r -- "ts=$(now_ts) version=$VERSION cwd=$PWD event=$*" >> "$LOG_FILE" 2>/dev/null || return 0
}

die() { log_event "error code=1 message=${(qqq)*}"; print -r -- "$*" >&2; exit 1; }
die_state() { log_event "error code=2 message=${(qqq)*}"; print -r -- "$*" >&2; exit 2; }
die_transport() { log_event "error code=3 message=${(qqq)*}"; print -r -- "$*" >&2; exit 3; }

now_ts() { "$DATE" "+%Y-%m-%dT%H:%M:%S%z"; }
pin() { printf "%06d\n" "$((100000 + RANDOM % 900000))"; }
session_id_for_pin() { print -r -- "$("$DATE" "+%Y-%m-%d-%H%M%S")-$1"; }

skill_invocation() {
  local skill="$1"
  if [[ "$SCRIPT_PATH" == */.claude/skills/* ]]; then
    print -r -- "/$skill"
  else
    print -r -- "\$$skill"
  fi
}

safe_write() {
  local path="$1"
  local tmp="$path.tmp.$$"
  "$CAT" > "$tmp"
  "$MV" "$tmp" "$path"
}

allowed_key() {
  case "$1" in
    COMMISSION_SESSION_ID|COMMISSION_PIN|COMMISSION_STATUS|COMMISSION_ACTIVE_RUN|COMMISSION_COMMISSIONER_ADAPTER|COMMISSION_COMMISSIONER_TERMINAL_ID|COMMISSION_CONSUMER_ADAPTER|COMMISSION_CONSUMER_TERMINAL_ID|COMMISSION_CONSUMER_GENERATION|COMMISSION_COMMISSIONER_CWD|COMMISSION_COMMISSIONER_REPO|COMMISSION_CONSUMER_CWD|COMMISSION_CONSUMER_REPO|COMMISSION_VERSION|COMMISSION_SOURCE|COMMISSION_RUN_ID|COMMISSION_RUN_STATUS|COMMISSION_PROMPT_PATH|COMMISSION_REPORT_PATH|COMMISSION_CREATED_AT|COMMISSION_SENT_AT|COMMISSION_REPORTED_AT|COMMISSION_REVIEWED_AT|COMMISSION_REVIEW_VERDICT|COMMISSION_REVIEW_PATH|COMMISSION_SUPERSEDED_BY)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

validate_value() {
  local key="$1" value="$2"
  [[ "$value" != *$'\n'* ]] || return 1
  case "$key" in
    COMMISSION_PROMPT_PATH|COMMISSION_REPORT_PATH)
      [[ "$value" == .commission/* ]]
      ;;
    COMMISSION_REVIEW_PATH)
      [[ -z "$value" || "$value" == .commission/* ]]
      ;;
    COMMISSION_COMMISSIONER_CWD|COMMISSION_COMMISSIONER_REPO|COMMISSION_CONSUMER_CWD|COMMISSION_CONSUMER_REPO)
      [[ -z "$value" || "$value" == /* ]]
      ;;
    COMMISSION_SESSION_ID)
      [[ "$value" == [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9] ]]
      ;;
    COMMISSION_PIN)
      [[ "$value" == <100000-999999> ]]
      ;;
    COMMISSION_STATUS|COMMISSION_RUN_STATUS)
      case "$value" in
        waiting_for_consumer|pending_consumer_connection|sent_to_consumer|reported|accepted|accepted_with_notes|passed_back|blocked|superseded|closed)
          return 0
          ;;
        *)
          return 1
          ;;
      esac
      ;;
    *)
      [[ -z "$value" || "$value" == [A-Za-z0-9._:/+-]## ]]
      ;;
  esac
}

cli_path() {
  print -r -- "$SCRIPT_PATH"
}

has_required_section() {
  local file="$1" label="$2"
  "$AWK" -v label="$label" '
    BEGIN { found=0 }
    $0 ~ "^" label ":[[:space:]]*" { found=1 }
    $0 ~ "^##[[:space:]]+" label "[[:space:]]*$" { found=1 }
    END { exit found ? 0 : 1 }
  ' "$file"
}

validate_consumer_prompt() {
  local prompt="$1" missing=()
  local section
  for section in "Goal" "Slice" "Approved context" "Acceptance criteria" "In scope" "Out of scope" "Expected evidence"; do
    has_required_section "$prompt" "$section" || missing+=("$section")
  done
  if (( ${#missing[@]} > 0 )); then
    print -r -- "Invalid Consumer prompt. Missing required section(s): ${(j:, :)missing}" >&2
    print -r -- "Required: Goal, Slice, Approved context, Acceptance criteria, In scope, Out of scope, Expected evidence." >&2
    exit 1
  fi
}

print_consumer_report_template() {
  print -r -- "# Consumer Report"
  print -r -- ""
  print -r -- "Status: DONE | BLOCKED | NEEDS_CONTEXT"
  print -r -- "Goal:"
  print -r -- "Slice:"
  print -r -- ""
  print -r -- "## Acceptance Results"
  print -r -- "- [criterion] PASS | FAIL | NOT VERIFIED - evidence or reason"
  print -r -- ""
  print -r -- "## Files Changed"
  print -r -- ""
  print -r -- "## Verification"
  print -r -- "- Command:"
  print -r -- "- Result:"
  print -r -- ""
  print -r -- "## Deviations"
  print -r -- ""
  print -r -- "## Residual Risks"
}

validate_consumer_report() {
  local report="$1" missing=()
  local section
  has_required_section "$report" "Status" || missing+=("Status")
  has_required_section "$report" "Goal" || missing+=("Goal")
  has_required_section "$report" "Slice" || missing+=("Slice")
  for section in "Acceptance Results" "Files Changed" "Verification" "Deviations" "Residual Risks"; do
    has_required_section "$report" "$section" || missing+=("$section")
  done
  if (( ${#missing[@]} > 0 )); then
    print -r -- "Invalid Consumer report. Missing required section(s): ${(j:, :)missing}" >&2
    print_consumer_report_template >&2
    exit 1
  fi
}

validate_env_file() {
  local file="$1"
  local line key prefix suffix value
  [[ -f "$file" ]] || return 1
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    key="${line%%=*}"
    allowed_key "$key" || die_state "Unknown COMMISSION env key in $file: $key"
    prefix="$key='"
    suffix="'"
    [[ "$line" == "$prefix"*"$suffix" ]] || die_state "Malformed COMMISSION env line in $file: $line"
    value="${line#$prefix}"
    value="${value%$suffix}"
    validate_value "$key" "$value" || die_state "Unsafe COMMISSION env value for $key in $file"
  done < "$file"
}

env_get() {
  local file="$1"
  local key="$2"
  allowed_key "$key" || die_state "Unknown COMMISSION env key: $key"
  [[ -f "$file" ]] || return 1
  validate_env_file "$file"
  local value
  value="$("$AWK" -F"'" -v key="$key" '$1 == key"=" && $3 == "" { print $2; found=1; exit } END { if (!found) exit 1 }' "$file")" || return 1
  validate_value "$key" "$value" || die_state "Unsafe COMMISSION env value for $key in $file"
  print -r -- "$value"
}

env_set() {
  local file="$1"
  local key="$2"
  local value="$3"
  allowed_key "$key" || die_state "Unknown COMMISSION env key: $key"
  validate_value "$key" "$value" || die_state "Unsafe COMMISSION env value for $key"
  validate_env_file "$file"
  local tmp="$file.tmp.$$"
  "$AWK" -v key="$key" -v value="$value" '
    BEGIN { done=0 }
    $0 ~ "^" key "=" { print key "='\''" value "'\''"; done=1; next }
    { print }
    END { if (!done) print key "='\''" value "'\''" }
  ' "$file" > "$tmp"
  "$MV" "$tmp" "$file"
}

active_session() {
  [[ -f "$ACTIVE_FILE" ]] || return 1
  "$CAT" "$ACTIVE_FILE"
}

repo_root() {
  "$GIT" rev-parse --show-toplevel 2>/dev/null || print -r -- "$PWD"
}

routing_key() {
  print -r -- "${1:A}" | "$CKSUM" | "$AWK" '{ print $1 }'
}

write_pin_route() {
  local pin_value="$1" sid="$2"
  "$MKDIR" -p "$PIN_INDEX_DIR"
  {
    print -r -- "COMMISSION_PIN='$pin_value'"
    print -r -- "COMMISSION_SESSION_ID='$sid'"
    print -r -- "COMMISSION_COMMISSIONER_CWD='${PWD:A}'"
  } | safe_write "$PIN_INDEX_DIR/$pin_value.env"
}

read_route_value() {
  local file="$1" key="$2"
  "$AWK" -F"'" -v key="$key" '$1 == key"=" && $3 == "" { print $2; found=1; exit } END { if (!found) exit 1 }' "$file"
}

route_for_pin() {
  local pin_value="$1"
  local file="$PIN_INDEX_DIR/$pin_value.env"
  [[ -f "$file" ]] || return 1
  read_route_value "$file" COMMISSION_COMMISSIONER_CWD
}

write_consumer_route() {
  local consumer_cwd="$1" commissioner_cwd="$2" sid="$3"
  local key
  "$MKDIR" -p "$CONSUMER_INDEX_DIR"
  key="$(routing_key "$consumer_cwd")"
  {
    print -r -- "COMMISSION_CONSUMER_CWD='${consumer_cwd:A}'"
    print -r -- "COMMISSION_COMMISSIONER_CWD='${commissioner_cwd:A}'"
    print -r -- "COMMISSION_SESSION_ID='$sid'"
  } | safe_write "$CONSUMER_INDEX_DIR/$key.env"
}

route_for_consumer_cwd() {
  local key file
  key="$(routing_key "$PWD")"
  file="$CONSUMER_INDEX_DIR/$key.env"
  [[ -f "$file" ]] || return 1
  read_route_value "$file" COMMISSION_COMMISSIONER_CWD
}

session_file() {
  print -r -- "$SESSIONS_DIR/$1/session.env"
}

require_active_session() {
  local sid
  sid="$(active_session)" || die "No active Commission session. Invoke $(skill_invocation commission) first."
  [[ -f "$(session_file "$sid")" ]] || die_state "Active Commission session is missing session.env: $sid"
  print -r -- "$sid"
}

capture_role() {
  local role="$1"
  "$GHOSTTY" capture-focused "$role" || die_transport "Ghostty capture failed for $role. If running from Codex, rerun the same command with escalation/outside-sandbox access so /usr/bin/osascript can control Ghostty."
}

capture_value() {
  local capture="$1"
  local key="$2"
  local value
  value="$(print -r -- "$capture" | "$AWK" -F"'" -v key="$key" '$1 == key"=" && $3 == "" { print $2; found=1; exit } END { if (!found) exit 1 }')" || die_transport "Ghostty capture did not return $key"
  print -r -- "$value"
}

create_session() {
  "$MKDIR" -p "$SESSIONS_DIR" "$STAGING_DIR"
  local p sid sdir capture arch_term commissioner_repo
  p="$(pin)"
  sid="$(session_id_for_pin "$p")"
  sdir="$SESSIONS_DIR/$sid"
  "$MKDIR" -p "$sdir/runs"
  capture="$(capture_role commissioner)"
  arch_term="$(capture_value "$capture" COMMISSION_COMMISSIONER_TERMINAL_ID)"
  commissioner_repo="$(repo_root)"
  {
    print -r -- "COMMISSION_SESSION_ID='$sid'"
    print -r -- "COMMISSION_PIN='$p'"
    print -r -- "COMMISSION_STATUS='waiting_for_consumer'"
    print -r -- "COMMISSION_ACTIVE_RUN=''"
    print -r -- "COMMISSION_COMMISSIONER_ADAPTER='ghostty-macos'"
    print -r -- "COMMISSION_COMMISSIONER_TERMINAL_ID='$arch_term'"
    print -r -- "COMMISSION_CONSUMER_ADAPTER=''"
    print -r -- "COMMISSION_CONSUMER_TERMINAL_ID=''"
    print -r -- "COMMISSION_CONSUMER_GENERATION='0'"
    print -r -- "COMMISSION_COMMISSIONER_CWD='${PWD:A}'"
    print -r -- "COMMISSION_COMMISSIONER_REPO='${commissioner_repo:A}'"
    print -r -- "COMMISSION_CONSUMER_CWD=''"
    print -r -- "COMMISSION_CONSUMER_REPO=''"
    print -r -- "COMMISSION_VERSION='$VERSION'"
  } | safe_write "$sdir/session.env"
  print -r -- "$sid" | safe_write "$ACTIVE_FILE"
  write_pin_route "$p" "$sid"
  log_event "commissioner.start mode=new session=$sid pin=$p commissioner_terminal=$arch_term"
  print -r -- "Commission session ready."
  print -r -- "Pin: $p"
  print -r -- "In Consumer, invoke: $(skill_invocation commission-connect) $p"
}

start_commissioner() {
  local sid sf
  [[ -z "${1:-}" || "${1:-}" == "--new" ]] || die "Usage: commission commissioner start"
  "$MKDIR" -p "$COMMISSION_DIR"
  if sid="$(active_session 2>/dev/null)" && [[ -f "$(session_file "$sid")" ]]; then
    sf="$(session_file "$sid")"
    env_set "$sf" COMMISSION_STATUS closed
    log_event "commissioner.start closed_previous_session=$sid"
  fi
  create_session
}

resume_commissioner() {
  local sid sf p arch_term
  "$MKDIR" -p "$COMMISSION_DIR"
  if sid="$(active_session 2>/dev/null)" && [[ -f "$(session_file "$sid")" ]]; then
    sf="$(session_file "$sid")"
    arch_term="$(env_get "$sf" COMMISSION_COMMISSIONER_TERMINAL_ID || true)"
    p="$(env_get "$sf" COMMISSION_PIN)"
    log_event "commissioner.resume session=$sid pin=$p commissioner_terminal=${arch_term:-absent}"
    print -r -- "Resumed Commission session."
    print -r -- "Pin: $p"
    return
  fi
  die "No active Commission session to resume. Invoke $(skill_invocation commission) to start a fresh session."
}

refresh_commissioner() {
  local sid sf p capture arch_term consumer_term
  sid="$(require_active_session)"
  sf="$(session_file "$sid")"
  p="$(env_get "$sf" COMMISSION_PIN)"
  capture="$(capture_role commissioner)"
  arch_term="$(capture_value "$capture" COMMISSION_COMMISSIONER_TERMINAL_ID)"
  consumer_term="$(env_get "$sf" COMMISSION_CONSUMER_TERMINAL_ID || true)"
  if [[ -n "$consumer_term" && "$arch_term" == "$consumer_term" ]]; then
    log_event "commissioner.refresh refused_collision session=$sid pin=$p commissioner_terminal=$arch_term consumer_terminal=$consumer_term"
    die_transport "Captured Commissioner transport matches Consumer transport. Focus the Commissioner Ghostty pane and rerun $(skill_invocation commission) refresh."
  fi
  env_set "$sf" COMMISSION_COMMISSIONER_ADAPTER ghostty-macos
  env_set "$sf" COMMISSION_COMMISSIONER_TERMINAL_ID "$arch_term"
  log_event "commissioner.refresh session=$sid pin=$p commissioner_terminal=$arch_term consumer_terminal=${consumer_term:-absent}"
  print -r -- "Refreshed Commissioner transport."
  print -r -- "Pin: $p"
}

next_run_id() {
  local sid="$1"
  local runs="$SESSIONS_DIR/$sid/runs"
  local max=0 n d
  "$MKDIR" -p "$runs"
  for d in "$runs"/[0-9][0-9][0-9](N); do
    n="${d:t}"
    (( 10#$n > max )) && max="$((10#$n))"
  done
  printf "%03d\n" "$((max + 1))"
}

write_run_env() {
  local sid="$1" rid="$2" new_status="$3"
  local rdir="$SESSIONS_DIR/$sid/runs/$rid"
  {
    print -r -- "COMMISSION_RUN_ID='$rid'"
    print -r -- "COMMISSION_RUN_STATUS='$new_status'"
    print -r -- "COMMISSION_PROMPT_PATH='$rdir/consumer-prompt.md'"
    print -r -- "COMMISSION_REPORT_PATH='$rdir/consumer-report.md'"
    print -r -- "COMMISSION_CREATED_AT='$(now_ts)'"
    print -r -- "COMMISSION_SENT_AT=''"
    print -r -- "COMMISSION_REPORTED_AT=''"
    print -r -- "COMMISSION_REVIEWED_AT=''"
    print -r -- "COMMISSION_REVIEW_VERDICT=''"
    print -r -- "COMMISSION_REVIEW_PATH=''"
    print -r -- "COMMISSION_SUPERSEDED_BY=''"
  } | safe_write "$rdir/run.env"
}

send_consumer() {
  [[ "${1:-}" == "--prompt-file" ]] || die "Usage: commission commissioner send-consumer --prompt-file <path>"
  local prompt="${2:-}"
  [[ -f "$prompt" ]] || die "Missing prompt file: $prompt"
  local legacy_prompt=0
  if [[ "$prompt" == .commission/staging/* ]]; then
    legacy_prompt=0
  elif [[ "$prompt" == .commission/tmp/* ]]; then
    legacy_prompt=1
  else
    die "Prompt file must be under .commission/staging/"
  fi
  validate_consumer_prompt "$prompt"
  local sid sf active active_env active_status rid rdir consumer_term run_status
  sid="$(require_active_session)"
  sf="$(session_file "$sid")"
  active="$(env_get "$sf" COMMISSION_ACTIVE_RUN || true)"
  if [[ -n "$active" ]]; then
    active_env="$SESSIONS_DIR/$sid/runs/$active/run.env"
    active_status="$(env_get "$active_env" COMMISSION_RUN_STATUS || true)"
    if [[ "$active_status" == "pending_consumer_connection" || "$active_status" == "sent_to_consumer" ]]; then
      env_set "$active_env" COMMISSION_RUN_STATUS superseded
    fi
  fi
  rid="$(next_run_id "$sid")"
  if [[ -n "$active" && -f "$active_env" ]]; then
    active_status="$(env_get "$active_env" COMMISSION_RUN_STATUS || true)"
    if [[ "$active_status" == "superseded" ]]; then
      env_set "$active_env" COMMISSION_SUPERSEDED_BY "$rid"
    fi
  fi
  rdir="$SESSIONS_DIR/$sid/runs/$rid"
  "$MKDIR" -p "$rdir"
  "$CP" "$prompt" "$rdir/consumer-prompt.md.tmp.$$"
  "$MV" "$rdir/consumer-prompt.md.tmp.$$" "$rdir/consumer-prompt.md"
  "$RM" -f "$prompt"
  consumer_term="$(env_get "$sf" COMMISSION_CONSUMER_TERMINAL_ID || true)"
  run_status="pending_consumer_connection"
  write_run_env "$sid" "$rid" "$run_status"
  env_set "$sf" COMMISSION_ACTIVE_RUN "$rid"
  env_set "$sf" COMMISSION_STATUS "$run_status"
  if [[ -n "$consumer_term" ]]; then
    "$GHOSTTY" send "$consumer_term" "Commissioner's Request: read and execute $rdir/consumer-prompt.md. When done, write $rdir/consumer-report.md using the acceptance template, then run $(cli_path) consumer notify." >/dev/null || die_transport "Failed to wake Consumer. Reconnect Consumer and retry. The prompt was copied to $rdir/consumer-prompt.md."
    env_set "$rdir/run.env" COMMISSION_RUN_STATUS sent_to_consumer
    env_set "$rdir/run.env" COMMISSION_SENT_AT "$(now_ts)"
    env_set "$sf" COMMISSION_STATUS sent_to_consumer
    log_event "commissioner.send_consumer session=$sid run=$rid status=sent_to_consumer consumer_terminal=$consumer_term"
    print -r -- "Passing this to the consumer..."
    print -r -- "Run: $rid"
  else
    log_event "commissioner.send_consumer session=$sid run=$rid status=pending_consumer_connection consumer_terminal=absent"
    print -r -- "Consumer is not connected."
    print -r -- "Run: $rid"
    print -r -- "Pin: $(env_get "$sf" COMMISSION_PIN)"
  fi
  [[ "$legacy_prompt" == "1" ]] && print -r -- "Note: accepted legacy staging path .commission/tmp; use .commission/staging going forward."
  [[ -n "$active" ]] && log_event "commissioner.send_consumer previous_active_run=$active new_run=$rid" && print -r -- "Previous active run superseded: $active"
  return 0
}

write_consumer_brief_once() {
  local sid="$1"
  local brief="$SESSIONS_DIR/$sid/consumer-brief.md"
  [[ -f "$brief" ]] && return
  "$CAT" > "$brief" <<'BRIEF'
# Commission Consumer Brief

You are the Consumer in a Commissioner-Consumer Loop.

For each Commissioner's Request:
1. Read the requested consumer-prompt.md.
2. Execute only that scope.
3. Write consumer-report.md using the requested template.
4. Run __COMMISSION_CLI_PATH__ consumer notify.

Prefer rtk for repo reads and searches when it is available. If rtk is not available in this shell, silently use the normal shell equivalent such as sed, rg, find, or git. Do not stop, complain, or report that rtk is unavailable unless the task specifically depends on rtk.

Do not commit unless explicitly instructed.
Do not broaden scope.

Work autonomously inside the handoff boundaries. Report NEEDS_CONTEXT only for missing required context, destructive actions, credentials, major structural changes, or scope conflicts.

Minimum consumer-report.md template:

# Consumer Report

Status: DONE | BLOCKED | NEEDS_CONTEXT
Goal:
Slice:

## Acceptance Results
- [criterion] PASS | FAIL | NOT VERIFIED - evidence or reason

## Files Changed

## Verification
- Command:
- Result:

## Deviations

## Residual Risks
BRIEF
  local tmp="$brief.tmp.$$"
  "$AWK" -v cli="$(cli_path)" '{ gsub("__COMMISSION_CLI_PATH__", cli); print }' "$brief" > "$tmp"
  "$MV" "$tmp" "$brief"
}

connect_consumer() {
  local p="${1:-}"
  local replace="${2:-}"
  local found="" sf existing capture consumer_term generation active active_env active_status consumer_cwd consumer_repo commissioner_root
  [[ -n "$p" ]] || die "Usage: commission consumer connect <pin> [--replace]"
  consumer_cwd="${PWD:A}"
  consumer_repo="$(repo_root)"
  if [[ ! -d "$COMMISSION_DIR" ]]; then
    commissioner_root="$(route_for_pin "$p" 2>/dev/null || true)"
    [[ -n "$commissioner_root" && -d "$commissioner_root/.commission" ]] || die "No .commission session with pin $p found. Ask the Commissioner for a fresh pin."
    cd "$commissioner_root"
  fi
  for sf in "$SESSIONS_DIR"/*/session.env(N); do
    [[ "$(env_get "$sf" COMMISSION_PIN || true)" == "$p" ]] && found="${sf:h:t}"
  done
  [[ -n "$found" ]] || die "No .commission session with pin $p found in this directory."
  sf="$(session_file "$found")"
  existing="$(env_get "$sf" COMMISSION_CONSUMER_TERMINAL_ID || true)"
  active="$(env_get "$sf" COMMISSION_ACTIVE_RUN || true)"
  active_status=""
  if [[ -n "$active" ]]; then
    active_env="$SESSIONS_DIR/$found/runs/$active/run.env"
    [[ -f "$active_env" ]] && active_status="$(env_get "$active_env" COMMISSION_RUN_STATUS || true)"
  fi
  if [[ -n "$existing" && "$replace" != "--replace" ]]; then
    case "$active_status" in
      pending_consumer_connection|sent_to_consumer)
        die "Consumer already connected for active run $active. Run: $(skill_invocation commission-connect) $p --replace"
        ;;
    esac
  fi
  write_consumer_brief_once "$found"
  capture="$(capture_role consumer)"
  consumer_term="$(capture_value "$capture" COMMISSION_CONSUMER_TERMINAL_ID)"
  env_set "$sf" COMMISSION_CONSUMER_ADAPTER ghostty-macos
  env_set "$sf" COMMISSION_CONSUMER_TERMINAL_ID "$consumer_term"
  env_set "$sf" COMMISSION_CONSUMER_CWD "$consumer_cwd"
  env_set "$sf" COMMISSION_CONSUMER_REPO "$consumer_repo"
  generation="$(env_get "$sf" COMMISSION_CONSUMER_GENERATION || print 0)"
  env_set "$sf" COMMISSION_CONSUMER_GENERATION "$((generation + 1))"
  write_consumer_route "$consumer_cwd" "$PWD" "$found"
  log_event "consumer.connect session=$found pin=$p replace=${replace:-0} consumer_terminal=$consumer_term generation=$((generation + 1)) active_run=${active:-absent} active_status=${active_status:-absent}"
  notify_commissioner_consumer_connected "$found" "$consumer_term"
  print -r -- "Connected to Commission session $p."
  print -r -- "Commissioner notified: Consumer connected and ready."
  print -r -- "Read your persistent consumer brief:"
  print -r -- "$SESSIONS_DIR/$found/consumer-brief.md"
  case "$active_status" in
    pending_consumer_connection|sent_to_consumer)
      [[ -n "$active" ]] && print -r -- "Pending Commissioner's Request: $SESSIONS_DIR/$found/runs/$active/consumer-prompt.md"
      ;;
  esac
  return 0
}

notify_commissioner_consumer_connected() {
  local sid="$1" consumer_term="$2"
  local sf arch_term active active_status active_env message
  sf="$(session_file "$sid")"
  arch_term="$(env_get "$sf" COMMISSION_COMMISSIONER_TERMINAL_ID || true)"
  [[ -n "$arch_term" && "$arch_term" != "$consumer_term" ]] || die_transport "Failed to notify Commissioner that Consumer connected. Ask Commissioner to run $(skill_invocation commission) refresh, then retry $(skill_invocation commission-connect) with --replace."
  active="$(env_get "$sf" COMMISSION_ACTIVE_RUN || true)"
  active_status=""
  if [[ -n "$active" ]]; then
    active_env="$SESSIONS_DIR/$sid/runs/$active/run.env"
    [[ -f "$active_env" ]] && active_status="$(env_get "$active_env" COMMISSION_RUN_STATUS || true)"
  fi
  message="Consumer connected and ready. Send the first handoff."
  case "$active_status" in
    pending_consumer_connection|sent_to_consumer)
      message="Consumer connected and ready. Pending run $active exists; Consumer should execute the pending prompt."
      ;;
  esac
  "$GHOSTTY" send "$arch_term" "$message" >/dev/null || die_transport "Failed to notify Commissioner that Consumer connected. Ask Commissioner to run $(skill_invocation commission) refresh, then retry $(skill_invocation commission-connect) with --replace."
  log_event "consumer.connect_notify session=$sid commissioner_terminal=$arch_term consumer_terminal=$consumer_term"
}

notify_consumer() {
  local sid sf active rdir report arch_term consumer_term run_status
  if [[ ! -d "$COMMISSION_DIR" ]]; then
    local commissioner_root
    commissioner_root="$(route_for_consumer_cwd 2>/dev/null || true)"
    [[ -n "$commissioner_root" && -d "$commissioner_root/.commission" ]] || die "No active Commission route for this Consumer cwd. Reconnect with $(skill_invocation commission-connect) <pin>."
    cd "$commissioner_root"
  fi
  sid="$(require_active_session)"
  sf="$(session_file "$sid")"
  active="$(env_get "$sf" COMMISSION_ACTIVE_RUN || true)"
  [[ -n "$active" ]] || die "No active run to notify."
  rdir="$SESSIONS_DIR/$sid/runs/$active"
  run_status="$(env_get "$rdir/run.env" COMMISSION_RUN_STATUS || true)"
  [[ "$run_status" != "superseded" ]] || die "Cannot notify for superseded run: $active"
  report="$rdir/consumer-report.md"
  [[ -f "$report" ]] || {
    print -r -- "Cannot notify Commissioner yet." >&2
    print -r -- "Missing: $report" >&2
    print_consumer_report_template >&2
    exit 1
  }
  validate_consumer_report "$report"
  arch_term="$(env_get "$sf" COMMISSION_COMMISSIONER_TERMINAL_ID || true)"
  consumer_term="$(env_get "$sf" COMMISSION_CONSUMER_TERMINAL_ID || true)"
  [[ -n "$arch_term" ]] || die_transport "Commissioner transport is missing or invalid. Ask Commissioner to run $(skill_invocation commission) refresh, then retry notify."
  [[ -z "$consumer_term" || "$arch_term" != "$consumer_term" ]] || die_transport "Commissioner transport is missing or invalid. Ask Commissioner to run $(skill_invocation commission) refresh, then retry notify."
  "$GHOSTTY" send "$arch_term" "Consumer's Report: read $report. Review against the goal, approved context, acceptance criteria, and repo state before approving or sending a follow-up." >/dev/null || die_transport "Failed to wake Commissioner. Refresh Commissioner by running $(skill_invocation commission) refresh."
  env_set "$rdir/run.env" COMMISSION_RUN_STATUS reported
  env_set "$rdir/run.env" COMMISSION_REPORTED_AT "$(now_ts)"
  env_set "$sf" COMMISSION_STATUS reported
  log_event "consumer.notify session=$sid run=$active status=reported commissioner_terminal=$arch_term consumer_terminal=$consumer_term report=$report"
  print -r -- "Consumer's Report sent."
}

review_run() {
  local verdict="" review_file="" sid sf active rdir normalized
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verdict)
        verdict="${2:-}"
        shift 2
        ;;
      --review-file)
        review_file="${2:-}"
        shift 2
        ;;
      *)
        die "Usage: commission commissioner review --verdict accepted|accepted-with-notes|passed-back|blocked --review-file <path>"
        ;;
    esac
  done
  [[ -n "$verdict" && -n "$review_file" ]] || die "Usage: commission commissioner review --verdict accepted|accepted-with-notes|passed-back|blocked --review-file <path>"
  [[ -f "$review_file" ]] || die "Missing review file: $review_file"
  [[ "$review_file" == .commission/staging/* || "$review_file" == .commission/tmp/* ]] || die "Review file must be under .commission/staging/"
  case "$verdict" in
    accepted) normalized="accepted" ;;
    accepted-with-notes|accepted_with_notes) normalized="accepted_with_notes" ;;
    passed-back|passed_back) normalized="passed_back" ;;
    blocked) normalized="blocked" ;;
    *) die "Unknown review verdict: $verdict" ;;
  esac
  sid="$(require_active_session)"
  sf="$(session_file "$sid")"
  active="$(env_get "$sf" COMMISSION_ACTIVE_RUN || true)"
  [[ -n "$active" ]] || die "No active run to review."
  rdir="$SESSIONS_DIR/$sid/runs/$active"
  [[ -f "$rdir/run.env" ]] || die_state "Active run missing run.env: $active"
  "$CP" "$review_file" "$rdir/commissioner-review.md.tmp.$$"
  "$MV" "$rdir/commissioner-review.md.tmp.$$" "$rdir/commissioner-review.md"
  "$RM" -f "$review_file"
  env_set "$rdir/run.env" COMMISSION_RUN_STATUS "$normalized"
  env_set "$rdir/run.env" COMMISSION_REVIEW_VERDICT "$normalized"
  env_set "$rdir/run.env" COMMISSION_REVIEW_PATH "$rdir/commissioner-review.md"
  env_set "$rdir/run.env" COMMISSION_REVIEWED_AT "$(now_ts)"
  env_set "$sf" COMMISSION_STATUS "$normalized"
  log_event "commissioner.review session=$sid run=$active verdict=$normalized review=$rdir/commissioner-review.md"
  print -r -- "Commissioner review recorded."
  print -r -- "Run: $active"
  print -r -- "Verdict: $normalized"
}

status_cmd() {
  local sid sf active consumer_term session_status next_action active_env run_status
  if ! sid="$(active_session 2>/dev/null)"; then
    log_event "status session=absent"
    print -r -- "No active Commission session."
    return
  fi
  sf="$(session_file "$sid")"
  [[ -f "$sf" ]] || die_state "Active session missing: $sid"
  session_status="$(env_get "$sf" COMMISSION_STATUS)"
  active="$(env_get "$sf" COMMISSION_ACTIVE_RUN || true)"
  consumer_term="$(env_get "$sf" COMMISSION_CONSUMER_TERMINAL_ID || true)"
  run_status=""
  if [[ -n "$active" ]]; then
    active_env="$SESSIONS_DIR/$sid/runs/$active/run.env"
    [[ -f "$active_env" ]] && run_status="$(env_get "$active_env" COMMISSION_RUN_STATUS || true)"
  fi
  next_action="Start or send a Consumer handoff."
  if [[ -z "$consumer_term" ]]; then
    next_action="Connect Consumer with $(skill_invocation commission-connect) $(env_get "$sf" COMMISSION_PIN)."
  elif [[ -n "$active" ]]; then
    case "$run_status" in
      pending_consumer_connection|sent_to_consumer)
        next_action="Wait for Consumer report or explicitly supersede active run $active."
        ;;
      reported)
        next_action="Review active run $active, then record a verdict."
        ;;
      accepted|accepted_with_notes|passed_back|blocked)
        next_action="Send the next handoff if more work remains."
        ;;
      *)
        next_action="Review active run state or wait for Consumer report."
        ;;
    esac
  fi
  print -r -- "Commission session: $sid"
  print -r -- "Root: $PWD"
  print -r -- "Pin: $(env_get "$sf" COMMISSION_PIN)"
  print -r -- "Status: $session_status"
  [[ -n "$consumer_term" ]] && print -r -- "Consumer: connected" || print -r -- "Consumer: not connected"
  print -r -- "Active run: $active"
  [[ -n "$run_status" ]] && print -r -- "Run status: $run_status"
  print -r -- "Next: $next_action"
  log_event "status session=$sid status=$session_status active_run=${active:-absent} consumer_terminal=${consumer_term:-absent}"
}

present_or_absent() {
  [[ -n "$1" ]] && print -r -- "$1" || print -r -- "absent"
}

doctor_cmd() {
  if [[ "${1:-}" == "ghostty" ]]; then
    shift
    doctor_ghostty "$@"
    return
  fi
  [[ -z "${1:-}" ]] || die "Usage: commission doctor [ghostty commissioner|consumer]"

  local sid="" sf="" active="" active_env="" marker_version="" marker_source=""
  local commissioner_adapter="" commissioner_terminal="" consumer_adapter="" consumer_terminal=""
  local pin_value="" session_status="" run_status=""

  if sid="$(active_session 2>/dev/null)"; then
    sf="$(session_file "$sid")"
    if [[ -f "$sf" ]]; then
      pin_value="$(env_get "$sf" COMMISSION_PIN || true)"
      session_status="$(env_get "$sf" COMMISSION_STATUS || true)"
      active="$(env_get "$sf" COMMISSION_ACTIVE_RUN || true)"
      commissioner_adapter="$(env_get "$sf" COMMISSION_COMMISSIONER_ADAPTER || true)"
      commissioner_terminal="$(env_get "$sf" COMMISSION_COMMISSIONER_TERMINAL_ID || true)"
      consumer_adapter="$(env_get "$sf" COMMISSION_CONSUMER_ADAPTER || true)"
      consumer_terminal="$(env_get "$sf" COMMISSION_CONSUMER_TERMINAL_ID || true)"
      if [[ -n "$active" ]]; then
        active_env="$SESSIONS_DIR/$sid/runs/$active/run.env"
        [[ -f "$active_env" ]] && run_status="$(env_get "$active_env" COMMISSION_RUN_STATUS || true)"
      fi
    fi
  fi

  if [[ -f "$GLOBAL_MARKER" ]]; then
    marker_version="$(env_get "$GLOBAL_MARKER" COMMISSION_VERSION || true)"
    marker_source="$(env_get "$GLOBAL_MARKER" COMMISSION_SOURCE || true)"
  fi

  print -r -- "Commission doctor"
  print -r -- "cli.version: $VERSION"
  print -r -- "cwd: $PWD"
  print -r -- "log.enabled: ${COMMISSION_LOG:-1}"
  print -r -- "log.path: $PWD/$LOG_FILE"
  [[ -d "$COMMISSION_DIR" ]] && print -r -- "commission.dir: present ($PWD/$COMMISSION_DIR)" || print -r -- "commission.dir: missing ($PWD/$COMMISSION_DIR)"
  print -r -- "session.id: $(present_or_absent "$sid")"
  print -r -- "session.pin: $(present_or_absent "$pin_value")"
  print -r -- "session.status: $(present_or_absent "$session_status")"
  print -r -- "run.id: $(present_or_absent "$active")"
  print -r -- "run.status: $(present_or_absent "$run_status")"
  [[ -n "$commissioner_adapter" && -n "$commissioner_terminal" ]] && print -r -- "transport.commissioner: present ($commissioner_adapter)" || print -r -- "transport.commissioner: missing"
  [[ -n "$consumer_adapter" && -n "$consumer_terminal" ]] && print -r -- "transport.consumer: present ($consumer_adapter)" || print -r -- "transport.consumer: missing"
  [[ -n "$commissioner_terminal" && "$commissioner_terminal" == "$consumer_terminal" ]] && print -r -- "transport.warning: commissioner and consumer terminal ids match; run $(skill_invocation commission) refresh in the Commissioner pane"
  [[ -z "$commissioner_terminal" || ( -n "$consumer_terminal" && "$commissioner_terminal" == "$consumer_terminal" ) ]] && print -r -- "next: run $(skill_invocation commission) refresh in Commissioner pane"
  if [[ -f "$GLOBAL_MARKER" ]]; then
    print -r -- "global.marker: present ($GLOBAL_MARKER)"
    print -r -- "global.version: $(present_or_absent "$marker_version")"
    print -r -- "global.source: $(present_or_absent "$marker_source")"
  else
    print -r -- "global.marker: missing ($GLOBAL_MARKER)"
    print -r -- "global.version: absent"
  fi
  [[ -x "$GHOSTTY" ]] && print -r -- "ghostty.adapter: executable ($GHOSTTY)" || print -r -- "ghostty.adapter: not executable ($GHOSTTY)"
  log_event "doctor session=${sid:-absent} status=${session_status:-absent} run=${active:-absent} run_status=${run_status:-absent}"
}

doctor_ghostty() {
  local role="${1:-}" capture code
  [[ "$role" == "commissioner" || "$role" == "consumer" ]] || die "Usage: commission doctor ghostty commissioner|consumer"

  set +e
  capture="$("$GHOSTTY" capture-focused "$role" 2>&1)"
  code="$?"
  set -e

  print -r -- "Commission doctor ghostty"
  print -r -- "role: $role"
  print -r -- "adapter.path: $GHOSTTY"
  [[ -x "$GHOSTTY" ]] && print -r -- "adapter.executable: yes" || print -r -- "adapter.executable: no"
  print -r -- "dry_run: ${ADL_GHOSTTY_DRY_RUN:-0}"
  if [[ "$code" == "0" ]]; then
    print -r -- "capture: ok"
    print -r -- "$capture"
    log_event "doctor.ghostty role=$role capture=ok"
    return
  fi

  print -r -- "capture: failed"
  print -r -- "exit_code: $code"
  print -r -- "error: $capture"
  print -r -- "next: If running from Codex, rerun the same command with escalation/outside-sandbox access so /usr/bin/osascript can control Ghostty."
  print -r -- "next: If escalation still fails, grant macOS Automation permission for osascript to control Ghostty, then retry."
  log_event "doctor.ghostty role=$role capture=failed exit_code=$code"
  exit 3
}

case "${1:-}" in
  commissioner)
    shift
    case "${1:-}" in
      start) shift; start_commissioner "${1:-}" ;;
      resume) shift; resume_commissioner ;;
      refresh) shift; refresh_commissioner ;;
      reconnect) shift; print -r -- "commissioner reconnect is deprecated; use commissioner refresh." >&2; refresh_commissioner ;;
      send-consumer) shift; send_consumer "$@" ;;
      review) shift; review_run "$@" ;;
      *) die "Usage: commission commissioner start | resume | refresh | send-consumer --prompt-file <path> | review --verdict <verdict> --review-file <path>" ;;
    esac
    ;;
  consumer)
    shift
    case "${1:-}" in
      connect) shift; connect_consumer "$@" ;;
      notify) notify_consumer ;;
      status) status_cmd ;;
      *) die "Usage: commission consumer connect <pin> [--replace] | notify | status" ;;
    esac
    ;;
  status)
    status_cmd
    ;;
  doctor)
    shift
    doctor_cmd "$@"
    ;;
  *)
    die "Usage: commission commissioner ... | consumer ... | status | doctor [ghostty commissioner|consumer]"
    ;;
esac
